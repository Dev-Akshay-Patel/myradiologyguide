<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsversion='3' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
  <head>
    <meta charset='UTF-8'/>
    <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
    <b:include data='blog' name='all-head-content'/>
    <title><data:blog.pageTitle/></title>

    <!-- Google Fonts -->
    <link href='https://fonts.googleapis.com' rel='preconnect'/>
    <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
    <link href='https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700;800&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap' rel='stylesheet'/>

    <!-- KaTeX Fast Math Typesetting -->
    <link href='https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css' rel='stylesheet'/>
    <script defer='defer' src='https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js'></script>
    <script defer='defer' src='https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js'></script>

    <!-- Prism JS Syntax Highlighting -->
    <link href='https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css' rel='stylesheet'/>
    <script defer='defer' src='https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js'></script>

    <!-- Instant Theme Preference Script -->
    <script>
      //<![CDATA[
      (function() {
        try {
          var t = localStorage.getItem('app-theme-preference');
          if (!t) {
            t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          var p = localStorage.getItem('app-palette-preference') || 'default';
          document.documentElement.setAttribute('data-palette', p);
        } catch(e) {}
      })();
      //]]>
    </script>

    <!-- Blogger Skin / Complete Embedded Stylesheet -->
    <b:skin version='1.3.0'><![CDATA[
/*{{COMBINED_CSS}}*/
    ]]></b:skin>

    <!-- Embedded Scripts -->
    <script>
      //<![CDATA[
/*{{COMBINED_JS}}*/
      //]]>
    </script>
  </head>
  <body expr:class='data:blog.pageType'>
    {{BODY_CONTENT}}
  </body>
</html>

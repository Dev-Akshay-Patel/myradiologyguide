{
  "name": "my-radiology-guide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:dicebear": "esbuild src/dicebear-bundle.ts --bundle --minify --format=iife --outfile=js/dicebear.js && cp js/dicebear.js vendor/dicebear/dicebear.min.js",
    "build:firebase": "esbuild src/firebase-comments.ts --bundle --minify --format=iife --outfile=js/firebase-comments.js",
    "build": "npm run build:dicebear && npm run build:firebase && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "11.0.0-rc.2",
    "@dicebear/lorelei": "9.4.2",
    "@dicebear/personas": "9.4.2",
    "@dicebear/styles": "11.0.0-rc.3",
    "@dicebear/thumbs": "^9.4.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "katex": "^0.18.9",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
